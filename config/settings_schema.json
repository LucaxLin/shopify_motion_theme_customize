  {
    "name": "Cart and currencies",
    "settings": [
      {
        "type": "header",
        "content": "Cart"
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "drawer",
        "options": [
          {
            "value": "page",
            "label": "Page"
          },
          {
            "value": "drawer",
            "label": "Drawer"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "cart_additional_buttons",
        "label": "Enable additional checkout buttons",
        "info": "The buttons can appear on either your cart page or your checkout page, but not both."
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enable",
        "label": "Enable order notes"
      },
      {
        "type": "checkbox",
        "id": "cart_terms_conditions_enable",
        "label": "Enable terms and conditions checkbox"
      },
      {
        "type": "url",
        "id": "cart_terms_conditions_link",
        "label": "Terms and conditions page"
      },
      {
        "type": "header",
        "content": "Multi-currency"
      },
      {
        "type": "checkbox",
        "id": "enable_currencies",
        "label": "Enable currency conversion",
        "default": false
      },
      {
        "type": "paragraph",
        "content": "[Shopify's multi-currency feature](https://help.shopify.com/en/manual/payments/shopify-payments/multi-currency) can be enabled in your Shopify Payments settings. It allows you to display prices and accept payments in multiple currencies."
      },
      {
        "type": "header",
        "content": "Currency converter"
      },
      {
        "type": "paragraph",
        "content": "If not using the native multi-currency feature but still want users to see prices in different currencies on your store, you must first [edit your store's currency formatting](https://help.shopify.com/manual/using-themes/troubleshooting/help-script-find-money-formats)."
      },
      {
        "type": "select",
        "id": "currency_format",
        "label": "Format",
        "options": [
          {
            "value": "money_format",
            "label": "Without currency ($10.00)"
          },
          {
            "value": "money_with_currency_format",
            "label": "With currency ($10.00 CAD)"
          }
        ],
        "default": "money_format",
        "info": "Does not work with amount_no_decimals format"
      },
      {
        "type": "text",
        "id": "supported_currencies",
        "label": "Supported currencies",
        "default": "USD CAD INR GBP AUD EUR JPY",
        "info": "Use the country's ISO [currency code](http://www.xe.com/iso4217.php). Separate your currency codes with a space."
      }
    ]
  },
